# Server-only. Never prefix these with VITE_.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
JWT_SECRET=replace-with-64-hex-characters
BIOMETRIC_ENCRYPTION_KEY=replace-with-64-hex-characters
# Optional previous key, kept during rotation so existing templates still decrypt.
BIOMETRIC_ENCRYPTION_KEY_PREVIOUS=
ADMIN_EMAIL=admin@attendance.local
ADMIN_PASSWORD=replace-with-a-long-password

# Safe to expose to the browser.
VITE_APP_NAME=Attendance
